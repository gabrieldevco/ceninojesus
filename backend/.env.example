# Copiar como .env y ajustar los valores. Nunca subir el .env al repositorio.
# Lo usan tanto Django (local) como docker-compose (db, backend y pgadmin).

# --- Django ---
# config.settings.dev (local) o config.settings.prod (servidor)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoria en producción. Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
# Si se comenta POSTGRES_DB, Django usa SQLite local (sin Docker).
# Con Docker, el contenedor backend usa POSTGRES_HOST=db automáticamente.
# docker/pgadmin/servers.json asume los valores por defecto de DB y usuario.
POSTGRES_DB=ceninojesus
POSTGRES_USER=ceninojesus
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@ceninojesus.com
PGADMIN_DEFAULT_PASSWORD=cambiar-esta-clave
