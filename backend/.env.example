# Copiar como .env y ajustar los valores. Nunca subir el .env al repositorio.
# Lo usan Django (local) y docker-compose (desarrollo y producción).

# --- Django ---
# config.settings.dev (local) o config.settings.prod (servidor). Docker lo fija por su cuenta.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoria en producción. Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Separados por comas. En producción: el dominio, p. ej. ceninojesus.edu.co
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Producción (docker-compose.prod.yml) ---
# Dominio público; Caddy obtiene el certificado HTTPS para él (localhost = certificado local de prueba)
DOMINIO=localhost
# Origen https del sitio, necesario para el admin de Django, p. ej. https://ceninojesus.edu.co
CSRF_TRUSTED_ORIGINS=
# Proxies delante de Django (Caddy = 1); solo producción
NUM_PROXIES=1

# --- Frontend ---
# Dirección del frontend: los correos de recuperación de contraseña enlazan a
# FRONTEND_URL/restablecer-contrasena?uid=...&token=...
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
# Si se comenta POSTGRES_DB, Django usa SQLite local (sin Docker).
# Con Docker, los contenedores usan POSTGRES_HOST=db automáticamente.
# docker/pgadmin/servers.json asume los valores por defecto de DB y usuario.
POSTGRES_DB=ceninojesus
POSTGRES_USER=ceninojesus
POSTGRES_PASSWORD=cambiar-esta-clave
# Sin Docker para Django pero con el contenedor db: localhost y 5434 (puerto expuesto en el equipo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Redis (caché, límite de envíos y cola de Celery) ---
# Docker lo fija a redis://redis:6379/0. Sin esta variable (local sin Docker) se usa la caché en base de datos
# y las tareas se ejecutan en el mismo proceso.
# REDIS_URL=redis://localhost:6379/0

# --- Autenticación JWT ---
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=7

# --- Límite de envíos por IP (formato: número/second|minute|hour|day) ---
# Formularios públicos (contacto, interesados, registro, solicitudes de datos)
LIMITE_FORMULARIOS=20/hour
# Inicio de sesión y recuperación de contraseña
LIMITE_AUTENTICACION=10/minute

# --- Correo (notificaciones, recuperación de contraseña, habeas data) ---
# En desarrollo los correos se imprimen en la consola del backend.
# En producción: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completar los datos SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-responder@ceninojesus.edu.co

# --- Tareas automáticas (Celery Beat) ---
# Días sin respuesta antes de enviar un recordatorio de interesados (RF-18)
INTERESADOS_DIAS_SIN_RESPUESTA=3
# Cada cuántos segundos corren los recordatorios y las alertas
WORKFLOW_INTERVALO_SEGUNDOS=3600

# --- Copias de seguridad (servicio backup, RNF-09) ---
BACKUP_INTERVALO_SEGUNDOS=86400
BACKUP_DIAS_RETENCION=14

# --- pgAdmin (solo desarrollo, http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@ceninojesus.com
PGADMIN_DEFAULT_PASSWORD=cambiar-esta-clave
