# Copiar como .env.local. Las variables VITE_* quedan visibles en el navegador: nunca poner secretos aquí.

# true = datos y cuentas de demostración, sin backend (útil para diseño)
VITE_MODO_DEMO=false

# Base de la API. Por defecto /api (mismo origen: Vite en desarrollo y Caddy en producción reenvían al backend)
# VITE_API_URL=/api
