# Servidor web de producción.
# - HTTPS automático (Let's Encrypt) para el dominio de la variable DOMINIO.
#   Con DOMINIO=localhost usa un certificado local, útil para probar.
# - /api, /admin y /static van al backend Django; todo lo demás es el frontend (dist).

{$DOMINIO:localhost} {
	encode zstd gzip

	# Tamaño máximo de una petición (material, actividades, entregas y videos propios de hasta 100 MB)
	request_body {
		max_size 105MB
	}

	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Archivos compilados: si no existen (versión anterior) responde 404 en vez de index.html,
	# para que el navegador sepa que debe recargar.
	handle /assets/* {
		root * /srv/frontend
		file_server
	}

	# Aplicación de una sola página: las rutas del frontend devuelven index.html
	handle {
		root * /srv/frontend
		# index.html siempre se revalida, así cada visita usa la versión publicada
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cross-Origin-Opener-Policy same-origin
		# Solo recursos propios, más las fuentes de Google; sin scripts en línea ni de terceros.
		# Los videos de YouTube del aula se incrustan desde youtube-nocookie.com; los videos subidos se reproducen como blob:.
		# style-src admite 'unsafe-inline' por los estilos que inyectan React y framer-motion.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
