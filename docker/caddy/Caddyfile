# Servidor web de producción.
# - HTTPS automático (Let's Encrypt) para el dominio de la variable DOMINIO.
#   Con DOMINIO=localhost usa un certificado local, útil para probar.
# - /api, /admin y /static van al backend Django; todo lo demás es el frontend (dist).

{$DOMINIO:localhost} {
	encode zstd gzip

	# Tamaño máximo de una petición (archivos de material y actividades)
	request_body {
		max_size 25MB
	}

	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Aplicación de una sola página: las rutas del frontend devuelven index.html
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cross-Origin-Opener-Policy same-origin
		# Solo recursos propios, más las fuentes de Google; sin scripts en línea ni de terceros.
		# style-src admite 'unsafe-inline' por los estilos que inyectan React y framer-motion.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
